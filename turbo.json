{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["DATABASE_URL", "BRAND_NAME", "BRAND_DOMAIN", "BRAND_LEGAL_ENTITY", "NEXT_PUBLIC_APP_URL", "NEXT_PUBLIC_WWW_URL", "ANTHROPIC_API_KEY", "BETTER_AUTH_SECRET", "BETTER_AUTH_URL"],
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": [".next/**", "!.next/cache/**", "dist/**"] },
    "dev": { "cache": false, "persistent": true },
    "lint": {},
    "typecheck": { "dependsOn": ["^typecheck"] },
    "test": { "dependsOn": ["^build"] }
  }
}
