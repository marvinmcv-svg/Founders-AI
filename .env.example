# ---------- Brand (plan 0D) ----------
BRAND_NAME="Founders AI"                 # Final name: human task H1
BRAND_LEGAL_ENTITY="Founders SCZ"        # Legal entity: human task H1
BRAND_DOMAIN="foundersscz.com"           # www., app., api., mcp. subdomains derive from this

# ---------- URLs ----------
NEXT_PUBLIC_WWW_URL="http://localhost:3000"   # marketing site
NEXT_PUBLIC_APP_URL="http://localhost:3001"   # product app (API mounted at /api/v1)

# ---------- Database (Postgres 16 + pgvector) ----------
DATABASE_URL="postgres://postgres:postgres@localhost:5432/founders"
SEED_SCALE="1"                 # 1 = plan 9.0 sizes (50k companies, 250k people...). 0.1 for a quick seed.

# ---------- Auth (Better Auth) ----------
BETTER_AUTH_SECRET="change-me-to-32-plus-random-characters"
BETTER_AUTH_URL="http://localhost:3001"

# ---------- AI (H3) ----------
ANTHROPIC_API_KEY=""            # Optional. Without it, NL search uses the deterministic parser.
ANTHROPIC_MODEL="claude-sonnet-5-5"

# ---------- Worker host (D-076) ----------
REDIS_URL="redis://localhost:6379"      # BullMQ (apps/workers). docker compose provides it locally; rediss:// for TLS.
WORKERS_QUEUE_PREFIX="founders"

# ---------- Not wired yet (H3 / H13) ----------
RESEND_API_KEY=""
CALCOM_API_KEY=""
NEXT_PUBLIC_CALCOM_LINK=""      # e.g. founders/demo — booking embed shows after the demo form when set
POSTHOG_KEY=""
SENTRY_DSN=""
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
STRIPE_SECRET_KEY=""

# ---------- Search (plan 8, D-075) ----------
OPENSEARCH_URL="http://localhost:9200"   # docker compose (pnpm dev:up). Set → `search-index` / `search-reindex` sync the indices.
OPENSEARCH_USERNAME=""                    # or put credentials in the URL (https://user:pass@host)
OPENSEARCH_PASSWORD=""
OPENSEARCH_INDEX_PREFIX="founders_"
SEARCH_BACKEND=""                         # "opensearch" serves grid/API/MCP search from the index (Postgres stays the fallback). Run `pnpm pipelines search-reindex` first.

# ---------- Public data pipelines (plan 9.1) ----------
SEC_USER_AGENT=""               # "Founders AI ops@yourdomain.com" — SEC fair-access policy. Unset: `sec-formd` skips live fetches.

# ---------- Internal admin (plan 7.14) ----------
# Comma-separated emails allowed into /admin (disclosure review queue, pipelines, model registry).
PLATFORM_ADMIN_EMAILS=""
# Token for /api/cron/* (pipelines, alerts, digests). Vercel Cron sends it as a Bearer token.
CRON_SECRET=""
# Optional: 32-byte base64 key for integration secrets (defaults to a key derived from BETTER_AUTH_SECRET).
INTEGRATIONS_ENCRYPTION_KEY=""

# Billing (Phase 10, H13). Without STRIPE_SECRET_KEY the app is in "contact sales" mode.
# BILLING_SIMULATOR=1 (local/demo only) runs checkout through an in-app simulator that sends signed webhook events.
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=
STRIPE_PRICE_SEAT_ANNUAL=
STRIPE_PRICE_CREDITS_10K=
STRIPE_PRICE_CREDITS_50K=
STRIPE_PRICE_CREDITS_250K=
STRIPE_OVERAGE_METER_EVENT=founders_credit_overage
BILLING_SIMULATOR=1
